<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">sans-serif</item>
        <!-- RTL global — applies to every view in every screen -->
        <item name="android:layoutDirection">rtl</item>
    </style>

    <!-- ── Toolbar ── -->
    <style name="AppToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/ToolbarTitle</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ── Buttons — base (required for dot-notation inheritance) ── -->
    <style name="Btn" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">8dp</item>
        <!-- RTL text alignment: text sticks to the start (= right in RTL) -->
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Btn.Secondary">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/error</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- ── Cards ── -->
    <style name="AppCard">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- ── Color theme variants ── -->
    <style name="Theme.MyApplication.Green" parent="Theme.MyApplication">
        <item name="colorPrimary">@color/theme_green</item>
        <item name="colorPrimaryContainer">@color/theme_green_light</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="Theme.MyApplication.Purple" parent="Theme.MyApplication">
        <item name="colorPrimary">@color/theme_purple</item>
        <item name="colorPrimaryContainer">@color/theme_purple_light</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="Theme.MyApplication.Red" parent="Theme.MyApplication">
        <item name="colorPrimary">@color/theme_red</item>
        <item name="colorPrimaryContainer">@color/theme_red_light</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <!-- ── Section header text ── -->
    <style name="SectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/neutral</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

</resources>
