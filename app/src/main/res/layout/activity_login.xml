<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".screens.Login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logoapp"
            android:contentDescription="לוגו"
            android:layout_marginBottom="10dp" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShiftCheck"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:layout_marginBottom="36dp" />

        <!-- Login card -->
        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/bg_login_card"
            android:layoutDirection="rtl">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="התחברות"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הכנס את פרטיך כדי להמשיך"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp" />

            <!-- Email label -->
            <TextView
                android:id="@+id/tvEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אימייל"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <!-- Email input -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="16dp" />

            <!-- Password label -->
            <TextView
                android:id="@+id/tvPassLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סיסמה"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <!-- Password input -->
            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="הכנס סיסמה"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="8dp" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginVertical="8dp" />

            <!-- Login button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="התחברות"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <!-- Register row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/tvNoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="אין לך חשבון?"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnGoRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="צור אחד"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
