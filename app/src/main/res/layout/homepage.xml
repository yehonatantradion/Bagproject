<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:layoutDirection="rtl"
    tools:context=".screens.MainActivity">

    <!-- ── Brand block (logo + name + subtitle) centered vertically ── -->
    <LinearLayout
        android:id="@+id/brandBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="165dp"
            android:layout_height="165dp"
            android:src="@drawable/logoapp"
            android:contentDescription="App Logo"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShiftCheck"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/subTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ניהול משמרות ונוכחות בקלות"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:alpha="0.75"
            android:gravity="center" />

    </LinearLayout>

    <!-- ── Button block anchored to lower third ── -->
    <LinearLayout
        android:id="@+id/buttonBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Login button — solid white -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="התחברות"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            android:layout_marginBottom="14dp" />

        <!-- Register button — transparent outlined -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="הרשמה"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShiftCheck © כל הזכויות שמורות"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:alpha="0.5"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
