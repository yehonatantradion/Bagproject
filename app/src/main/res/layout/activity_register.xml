<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".screens.Register">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logoapp"
            android:contentDescription="לוגו"
            android:layout_marginBottom="10dp" />

        <!-- App name -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShiftCheck"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:layout_marginBottom="32dp" />

        <!-- Register card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/bg_login_card"
            android:layoutDirection="rtl">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="יצירת חשבון"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מלא את הפרטים כדי להמשיך"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <!-- שם פרטי -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם פרטי"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etFname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="שם פרטי"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="16dp" />

            <!-- שם משפחה -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם משפחה"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etLname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="שם משפחה"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="16dp" />

            <!-- טלפון -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="טלפון"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="050-0000000"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="16dp" />

            <!-- אימייל -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אימייל"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="16dp" />

            <!-- סיסמה -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סיסמה"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="לפחות 6 תווים"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="8dp" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginVertical="8dp" />

            <!-- Register button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="הירשם"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <!-- Login row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/tvHaveAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="כבר יש לך חשבון?"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="התחבר"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShiftCheck © כל הזכויות שמורות"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:alpha="0.6"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
