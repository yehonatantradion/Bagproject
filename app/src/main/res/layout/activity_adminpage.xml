<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl"
    tools:context=".screens.adminpage">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="ניהול מערכת"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAdminTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שלום, מנהל"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvAdminSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ניהול עובדים, משמרות ונוכחות"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/logoapp"
                    android:contentDescription="לוגו" />

            </LinearLayout>

            <!-- Section: עובדים -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="עובדים" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnManageWorkers"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="ניהול עובדים"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="@android:color/transparent"
                        android:drawableStart="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: משמרות -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="משמרות"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnManageShifts"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="משמרת נוכחית"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="@android:color/transparent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/divider" />

                    <Button
                        android:id="@+id/btnAddShift"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="הוספת משמרת חדשה"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="@android:color/transparent" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: דוחות -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="נוכחות"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnTodayAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="נוכחות היום"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="@android:color/transparent" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: מערכת -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="מערכת"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="הגדרות מערכת"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="@android:color/transparent" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="התנתקות"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/error"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="8dp"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
