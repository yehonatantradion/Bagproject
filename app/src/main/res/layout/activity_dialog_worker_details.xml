<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="פרטי עובד ועריכה"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etWorkerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="שם מלא"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#DDDDDD"/>

        <EditText
            android:id="@+id/etWorkerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="טלפון"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etWorkerEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="אימייל"
            android:enabled="false"
            android:alpha="0.6"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הגדרת תפקיד:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbWorker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עובד רגיל"
                android:layout_marginEnd="24dp"/>

            <RadioButton
                android:id="@+id/rbManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מנהל" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שמור שינויים"
            android:backgroundTint="#4CAF50"
            android:textStyle="bold"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>