<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="עריכת עובד"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="40dp">

            <!-- Avatar + name header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:textSize="28sp"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_avatar_circle"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_badge_role" />

            </LinearLayout>

            <!-- Editable fields card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <!-- שם פרטי -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שם פרטי"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etFName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="שם פרטי"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|end"
                        android:layout_marginBottom="14dp" />

                    <!-- שם משפחה -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שם משפחה"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etLName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="שם משפחה"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|end"
                        android:layout_marginBottom="14dp" />

                    <!-- טלפון -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="טלפון"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="050-0000000"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|end"
                        android:layout_marginBottom="14dp" />

                    <!-- תפקיד -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תפקיד"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etJobTitle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="לדוגמה: מלצר, קופאי"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|end"
                        android:layout_marginBottom="14dp" />

                    <!-- אימייל (קריאה בלבד) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אימייל (לא ניתן לשינוי)"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input"
                        android:textSize="14sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center_vertical|end"
                        android:enabled="false"
                        android:layout_marginBottom="14dp" />

                    <!-- הרשאה -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הרשאה"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbWorker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="עובד רגיל"
                            android:textColor="@color/text_primary"
                            android:layout_marginEnd="24dp" />

                        <RadioButton
                            android:id="@+id/rbAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="מנהל"
                            android:textColor="@color/text_primary" />

                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="שמור שינויים"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <!-- Delete button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteWorker"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="מחק משתמש"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/error"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
